+    $assert_session->elementNotExists('css', '#edit-group .file--mime-text-plain');
+    $assert_session->elementExists('css', $textfield_selector);
+    $this->submitForm([], 'Save');
+    $assert_session->pageTextContains('The file ids are .');
+  }
