+    $fid = $this->getLastFileId();
+    $this->submitForm([], 'Save');
+    $assert_session->pageTextContains("The file ids are $fid.");
+
+    $this->drupalGet('file/test/1/0/0/' . $fid, ['query' => ['grouped' => 1]]);
+    $this->getSession()->getPage()->pressButton('Remove');
