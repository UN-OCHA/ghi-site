+{#
+/**
+ * @file
+ * Wraps a Layout Builder component with enhanced placement controls.
+ *
+ * Available variables:
+ * - before: The add-block control before the component.
+ * - children: The complete rendered block, including its theme wrappers.
+ * - after: The add-block control after the component.
+ */
+#}
+{{ before }}
+{{ children }}
+{{ after }}
diff --git a/tests/src/Kernel/BlockComponentRenderArrayTest.php b/tests/src/Kernel/BlockComponentRenderArrayTest.php
new file mode 100644
index 0000000..ef3c194
--- /dev/null
+++ b/tests/src/Kernel/BlockComponentRenderArrayTest.php
@@ -0,0 +1,253 @@
+<?php
+
+namespace Drupal\Tests\layout_builder_ipe\Kernel;
+
+use Drupal\Core\Access\AccessResult;
+use Drupal\Core\Block\BlockPluginInterface;
+use Drupal\Core\Cache\Cache;
+use Drupal\Core\Config\ConfigFactoryInterface;
+use Drupal\Core\Config\ImmutableConfig;
+use Drupal\Core\Entity\EntityInterface;
+use Drupal\Core\Security\TrustedCallbackInterface;
+use Drupal\Core\Session\AccountInterface;
+use Drupal\KernelTests\KernelTestBase;
+use Drupal\layout_builder\Event\SectionComponentBuildRenderArrayEvent;
+use Drupal\layout_builder\EventSubscriber\BlockComponentRenderArray as CoreBlockComponentRenderArray;
+use Drupal\layout_builder\Section;
+use Drupal\layout_builder\SectionComponent;
+use Drupal\layout_builder\SectionStorageInterface;
+use Drupal\layout_builder_ipe\EventSubscriber\BlockComponentRenderArray;
+use Drupal\layout_builder_ipe\LayoutBuilder\LayoutBuilderUi;
+use Drupal\layout_builder_ipe\LayoutBuilderIpeAccess;
+use Drupal\layout_builder_ipe\LayoutBuilderIpeContext;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests enhanced controls with Drupal's renderer and block preprocessing.
+ *
+ * @group layout_builder_ipe
+ */
+#[RunTestsInSeparateProcesses]
+class BlockComponentRenderArrayTest extends KernelTestBase implements TrustedCallbackInterface {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'system',
+    'user',
+    'field',
+    'text',
+    'filter',
+    'block',
+    'contextual',
+    'layout_discovery',
+    'layout_builder',
+    'layout_builder_ipe',
+  ];
+
+  /**
+   * Number of times cacheable content was actually rendered.
+   */
+  protected static int $contentBuilds = 0;
+
+  /**
+   * Number of times the lazy builder was called.
+   */
+  protected static int $lazyBuilds = 0;
+
+  /**
+   * Tests block preprocessing can move a direct child after the main content.
+   */
+  public function testPreprocessedFootnoteFollowsContent(): void {
+    $registry = $this->container->get('theme.registry')->getRuntime();
+    $definition = $registry->get('block');
+    $definition['preprocess functions'][] = static::class . '::preprocessBlock';
+    $registry->set('block', $definition);
+
+    foreach ([FALSE, TRUE] as $preview) {
+      $build = $this->createComponentBuild([
+        'comment' => ['#markup' => 'Footnote'],
+        'figures' => ['#markup' => 'Figures'],
+      ], $preview);
+      $markup = (string) $this->container->get('renderer')->renderRoot($build);
+      $this->assertMatchesRegularExpression('/Figures.*Footnote/s', $markup);
+    }
+  }
+
+  /**
+   * Tests preview controls never enter or disappear into the content cache.
+   */
+  public function testRenderCacheIsolationInBothDirections(): void {
+    foreach ([FALSE, TRUE] as $preview_first) {
+      static::$contentBuilds = 0;
+      $content = [
+        '#markup' => 'Cacheable content',
+        '#cache' => [
+          'keys' => ['ipe_content', (string) (int) $preview_first],
+          'tags' => ['ipe:content'],
+        ],
+        '#pre_render' => [[static::class, 'countContentBuild']],
+      ];
+      foreach ([$preview_first, !$preview_first] as $preview) {
+        $build = $this->createComponentBuild($content, $preview);
+        $markup = (string) $this->container->get('renderer')->renderRoot($build);
+        $this->assertStringContainsString('Cacheable content', $markup);
+        if ($preview) {
+          $this->assertSame(0, $build['#cache']['max-age']);
+          $this->assertStringContainsString('Before control', $markup);
+          $this->assertStringContainsString('After control', $markup);
+          $this->assertContains('ipe:controls', $build['#cache']['tags']);
+          $this->assertTrue($build['#attached']['drupalSettings']['ipe_controls']);
+        }
+        else {
+          $this->assertStringNotContainsString('Before control', $markup);
+          $this->assertStringNotContainsString('After control', $markup);
+          $this->assertNotContains('ipe:controls', $build['#cache']['tags']);
+          $this->assertArrayNotHasKey('ipe_controls', $build['#attached']['drupalSettings'] ?? []);
+        }
+      }
+      // The second render must actually hit the same child cache entry.
+      $this->assertSame(1, static::$contentBuilds);
+    }
+  }
+
+  /**
+   * Tests both immediate and placeholder-based lazy builders remain valid.
+   */
+  public function testLazyBuilders(): void {
+    foreach ([FALSE, TRUE] as $placeholder) {
+      static::$lazyBuilds = 0;
+      $content = [
+        '#lazy_builder' => [static::class . '::buildLazyContent', []],
+        '#create_placeholder' => $placeholder,
+      ];
+      $build = $this->createComponentBuild($content);
+      $this->assertSame($content, $build['content']);
+      $markup = (string) $this->container->get('renderer')->renderRoot($build);
+      $this->assertMatchesRegularExpression('/Before control.*Lazy content.*After control/s', $markup);
+      $this->assertStringNotContainsString('<drupal-render-placeholder', $markup);
+      $this->assertSame(1, static::$lazyBuilds);
+      $this->assertContains('ipe:lazy', $build['#cache']['tags']);
+    }
+  }
+
+  /**
+   * Tests root render elements retain their default theme wrappers.
+   */
+  public function testElementDefaults(): void {
+    $build = $this->createComponentBuild([
+      '#type' => 'container',
+      'figures' => ['#markup' => '<p>Figures</p>'],
+    ]);
+    $markup = (string) $this->container->get('renderer')->renderRoot($build);
+    $this->assertMatchesRegularExpression('/<div>\s*<p>Figures<\/p>\s*<\/div>/', $markup);
+    $this->assertMatchesRegularExpression('/Before control.*Figures.*After control/s', $markup);
+  }
+
+  /**
+   * Tests inaccessible content stays hidden without removing its controls.
+   */
+  public function testInaccessibleContent(): void {
+    $build = $this->createComponentBuild([
+      '#access' => FALSE,
+      '#markup' => 'Inaccessible content',
+    ]);
+    $markup = (string) $this->container->get('renderer')->renderRoot($build);
+    $this->assertStringNotContainsString('Inaccessible content', $markup);
+    $this->assertStringContainsString('Before control', $markup);
+    $this->assertStringContainsString('After control', $markup);
+  }
+
+  /**
+   * Simulates a theme that moves a footnote from the direct content children.
+   */
+  public static function preprocessBlock(array &$variables): void {
+    if (isset($variables['content']['comment'])) {
+      $comment = $variables['content']['comment'];
+      unset($variables['content']['comment']);
+      $variables['content']['trailing_comment'] = $comment;
+    }
+  }
+
+  /**
+   * Counts uncached renders without changing the content.
+   */
+  public static function countContentBuild(array $element): array {
+    static::$contentBuilds++;
+    return $element;
+  }
+
+  /**
+   * Builds deferred block content.
+   */
+  public static function buildLazyContent(): array {
+    static::$lazyBuilds++;
+    return [
+      '#markup' => 'Lazy content',
+      '#cache' => ['tags' => ['ipe:lazy']],
+    ];
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function trustedCallbacks(): array {
+    return ['countContentBuild', 'buildLazyContent'];
+  }
+
+  /**
+   * Builds a component through core and IPE, including event cache metadata.
+   */
+  protected function createComponentBuild(array $content, bool $preview = TRUE): array {
+    $block = $this->createMock(BlockPluginInterface::class);
+    $block->method('build')->willReturn($content);
+    $block->method('label')->willReturn('Test block');
+    $block->method('getConfiguration')->willReturn([
+      'provider' => 'system',
+      'label' => 'Test block',
+      'label_display' => FALSE,
+    ]);
+    $block->method('getPluginId')->willReturn('ipe_render_test');
+    $block->method('getBaseId')->willReturn('ipe_render_test');
+    $block->method('getCacheMaxAge')->willReturn(Cache::PERMANENT);
+    $block->method('getCacheContexts')->willReturn([]);
+    $block->method('getCacheTags')->willReturn([]);
+    $block->method('access')->willReturn(AccessResult::allowed());
+    $component = $this->getMockBuilder(SectionComponent::class)
+      ->setConstructorArgs(['test-component', 'content'])
+      ->onlyMethods(['getPlugin'])
+      ->getMock();
+    $component->method('getPlugin')->willReturn($block);
+    $storage = $this->createMock(SectionStorageInterface::class);
+    $storage->method('getSections')->willReturn([new Section('layout_onecol', [], [$component])]);
+    $entity = $this->createMock(EntityInterface::class);
+    $context = $this->createMock(LayoutBuilderIpeContext::class);
+    $context->method('getSectionStorage')->willReturn($storage);
+    $context->method('getEntityFromSectionStorage')->willReturn($entity);
+    $access = $this->createMock(LayoutBuilderIpeAccess::class);
+    $access->method('ipeEnabled')->willReturn(TRUE);
+    $ui = $this->createMock(LayoutBuilderUi::class);
+    $ui->method('createAddButton')->willReturnCallback(static function (SectionComponent $component, SectionStorageInterface $storage, int $delta, string $placement): array {
+      return [
+        '#markup' => ucfirst($placement) . ' control',
+        '#cache' => ['tags' => ['ipe:controls']],
+        '#attached' => ['drupalSettings' => ['ipe_controls' => TRUE]],
+      ];
+    });
+    $config = $this->createMock(ImmutableConfig::class);
+    $config->method('get')->with('enhance_ui')->willReturn(TRUE);
+    $config_factory = $this->createMock(ConfigFactoryInterface::class);
+    $config_factory->method('get')->willReturn($config);
+
+    $event = new SectionComponentBuildRenderArrayEvent($component, [], $preview);
+    $core = new CoreBlockComponentRenderArray($this->createMock(AccountInterface::class));
+    $core->onBuildRender($event);
+    $subscriber = new BlockComponentRenderArray($context, $access, $ui, $config_factory);
+    $subscriber->onBuildRender($event);
+    $build = $event->getBuild();
+    $event->getCacheableMetadata()->applyTo($build);
+    return $build;
+  }
+
+}
