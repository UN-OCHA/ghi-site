diff --git a/core/tests/Drupal/KernelTests/Core/Menu/LocalTaskManagerTest.php b/core/tests/Drupal/KernelTests/Core/Menu/LocalTaskManagerTest.php
new file mode 100644
index 0000000..799330a
--- /dev/null
+++ b/core/tests/Drupal/KernelTests/Core/Menu/LocalTaskManagerTest.php
@@ -0,0 +1,76 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\KernelTests\Core\Menu;
+
+use Drupal\Core\Cache\RefinableCacheableDependencyInterface;
+use Drupal\Core\Hook\Attribute\Hook;
+use Drupal\Core\Menu\LocalTaskManager;
+use Drupal\KernelTests\KernelTestBase;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\IgnoreDeprecations;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests the local task manager.
+ */
+#[CoversClass(LocalTaskManager::class)]
+#[Group('Menu')]
+#[RunTestsInSeparateProcesses]
+class LocalTaskManagerTest extends KernelTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = ['system', 'user'];
+
+  /**
+   * Tests that legacy task alters run before the replacement hook.
+   */
+  #[IgnoreDeprecations]
+  public function testDeprecatedLocalTasksAlter(): void {
+    $this->expectUserDeprecationMessage('The deprecated alter hook hook_menu_local_tasks_alter() is implemented in these locations: Drupal\KernelTests\Core\Menu\LocalTaskManagerTest::menuLocalTasksAlter. Deprecated in drupal:12.0.0 and is removed from drupal:13.0.0. Use hook_local_tasks_render_alter() instead. See https://www.drupal.org/node/3028611');
+
+    /** @var \Drupal\Core\Menu\LocalTaskManagerInterface $manager */
+    $manager = $this->container->get('plugin.manager.menu.local_task');
+    $tasks = $manager->getLocalTasks('test_route');
+    $this->assertSame('Altered task', $tasks['tabs']['test']['#link']['title']);
+    $this->assertSame('test_route', $tasks['route_name']);
+    $this->assertSame(['legacy-task', 'altered-task'], $tasks['cacheability']->getCacheTags());
+    $this->assertSame(['route', 'user.permissions'], $tasks['cacheability']->getCacheContexts());
+    $this->assertSame(60, $tasks['cacheability']->getCacheMaxAge());
+
+    // Both tab levels share the altered data and its cacheability metadata.
+    $secondary_tasks = $manager->getLocalTasks('test_route', 1);
+    $this->assertSame([], $secondary_tasks['tabs']);
+    $this->assertSame($tasks['cacheability'], $secondary_tasks['cacheability']);
+  }
+
+  /**
+   * Implements hook_menu_local_tasks_alter().
+   */
+  #[Hook('menu_local_tasks_alter')]
+  public function menuLocalTasksAlter(array &$data, string $route_name, RefinableCacheableDependencyInterface &$cacheability): void {
+    $this->assertSame('test_route', $route_name);
+    $data['tabs'][0]['test']['#link']['title'] = 'Legacy task';
+    $cacheability->addCacheTags(['legacy-task']);
+    $cacheability->addCacheContexts(['user.permissions']);
+  }
+
+  /**
+   * Implements hook_local_tasks_render_alter().
+   */
+  #[Hook('local_tasks_render_alter')]
+  public function localTasksRenderAlter(array &$data, string $route_name, RefinableCacheableDependencyInterface &$cacheability): void {
+    $this->assertSame('test_route', $route_name);
+    // The new hook must receive the legacy hook's changes, not the original data.
+    $this->assertSame('Legacy task', $data['tabs'][0]['test']['#link']['title']);
+    $this->assertSame(['legacy-task'], $cacheability->getCacheTags());
+    $data['tabs'][0]['test']['#link']['title'] = 'Altered task';
+    $cacheability->addCacheTags(['altered-task']);
+    $cacheability->mergeCacheMaxAge(60);
+  }
+
+}
