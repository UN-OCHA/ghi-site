<?php

/**
 * @file
 * Install and update guidance for the GHI Menu module.
 *
 * Backend menu links are content entities and are not synchronized by config
 * imports. Deploy hooks that run after configuration imports can synchronize
 * the corresponding links. Place implementations in ghi_menu.deploy.php:
 *
 * @code
 * function ghi_menu_deploy_sync_backend_menu(&$sandbox) {
 *   $result = \Drupal::service('ghi_menu.backend_menu_manager')->syncContentViewLinks();
 *   return t('Synchronized @saved backend menu links and deleted @deleted obsolete links.', [
 *     '@saved' => $result['saved'],
 *     '@deleted' => $result['deleted'],
 *   ]);
 * }
 * @endcode
 */
