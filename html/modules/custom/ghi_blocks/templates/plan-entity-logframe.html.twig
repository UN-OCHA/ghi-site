{{ attach_library('common_design/cd-grid') }}
{{ attach_library('common_design_subtheme/ghi-entity-logframe') }}

{%- if items -%}
  <div class="item-list--entity-logframe">
    {%- for item in items -%}
      {%
        set wrapper_classes = [
          'entity-wrapper',
          item.attachment_tables is empty ? 'no-tables',
          item.contributes_heading is empty ? 'no-alignment',
        ]
      %}
      <div class="item-wrapper">
        <div class="{{ wrapper_classes|join(' ') }}">
          <div class="entity-wrapper--inner">
            <p class="label">{{ item.label }}</p>
            <p class="description">{{ item.description }}</p>
          </div>
          <span class="table-toggle material-icon" tabindex="0" data-toggle="tooltip" data-tippy-content="{{ tooltip_show_data }}" data-tippy-content-open="{{ tooltip_hide_data }}"><svg aria-hidden="true" focusable="false"><use href="#material-symbol-keyboard-arrow-down" xlink:href="#material-symbol-keyboard-arrow-down"></use></svg></span>
          <span class="table-no-data material-icon" data-toggle="tooltip" data-tippy-content="{{ tooltip_no_data }}"><svg aria-hidden="true" focusable="false"><use href="#material-symbol-horizontal-rule" xlink:href="#material-symbol-horizontal-rule"></use></svg></span>
        </div>
        {%- if not item.attachment_tables is empty or not item.contributes_heading is empty -%}
          <div class="attachment-tables-wrapper">
            {%- if not item.contributes_heading is empty -%}
              {{ item.contributes_heading }}
            {%- endif -%}
            {{ item.attachment_tables }}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}
