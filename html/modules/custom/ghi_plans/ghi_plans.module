<?php

/**
 * @file
 * Contains hook implementations for the GHI Plans module.
 */

use Drupal\Component\Utility\Unicode;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Form\FormStateInterface;
use Drupal\ghi_base_objects\ApiObjects\Country;
use Drupal\ghi_base_objects\Helpers\BaseObjectHelper;
use Drupal\ghi_plans\ApiObjects\Organization;
use Drupal\ghi_plans\Entity\GoverningEntity;
use Drupal\ghi_plans\Entity\Plan;
use Drupal\ghi_plans\Entity\PlanCostingType;
use Drupal\ghi_plans\Entity\PlanType;
use Drupal\ghi_plans\Form\PlanFormAlter;
use Drupal\migrate\MigrateSkipRowException;
use Drupal\migrate\Plugin\MigrateSourceInterface;
use Drupal\migrate\Plugin\MigrationInterface;
use Drupal\migrate\Row;

/**
 * Implements hook_entity_bundle_info_alter().
 */
function ghi_plans_entity_bundle_info_alter(array &$bundles) {
  $bundles['base_object']['plan']['class'] = Plan::class;
  $bundles['base_object']['plan']['label'] = t('Plan');
  $bundles['base_object']['governing_entity']['class'] = GoverningEntity::class;
  $bundles['base_object']['governing_entity']['label'] = t('Governing Entity');
  $bundles['taxonomy_term']['plan_type']['class'] = PlanType::class;
  $bundles['taxonomy_term']['plan_type']['label'] = t('Plan type');
  $bundles['taxonomy_term']['plan_costing']['class'] = PlanCostingType::class;
  $bundles['taxonomy_term']['plan_costing']['label'] = t('Plan costing');
}

/**
 * Implements hook_cron().
 *
 * Update the requirements for the plan.
 */
function ghi_plans_cron() {
  $storage = \Drupal::entityTypeManager()->getStorage('base_object');
  $query = $storage->getQuery();
  $query->accessCheck(FALSE);
  $query->condition('type', 'plan');
  $query->sort('field_requirements_updated');
  $query->pager(250);
  $results = $query->execute();
  $plans = $storage->loadMultiple($results);
  foreach ($plans as $plan) {
    if (!$plan instanceof Plan) {
      continue;
    }
    $plan->updateFinancialData();
    $plan->setSyncing(TRUE);
    $plan->save();
  }
}

/**
 * Implements hook_page_attachments().
 */
function ghi_plans_page_attachments(array &$page) {
  $cache = CacheableMetadata::createFromRenderArray($page);
  $page['#attached']['html_head_link'][] = [
    [
      'href' => 'https://fonts.googleapis.com/icon?family=Material+Icons',
      'rel' => 'stylesheet',
    ],
  ];
  // Apply updated caching information.
  $cache->applyTo($page);
}

/**
 * Implements hook_preprocess_page().
 */
function ghi_plans_preprocess_page(array &$variables) {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'] ?? NULL;
  /** @var \Drupal\ghi_base_objects\Entity\BaseObjectInterface $base_object */
  $base_object = $node ? BaseObjectHelper::getBaseObjectFromNode($node) : NULL;
  if ($base_object && $base_object instanceof Plan) {
    $variables['#attached']['drupalSettings']['plan_settings'] = [
      'decimal_format' => $base_object->getDecimalFormat(),
      'langcode' => $base_object->getPlanLanguage(),
    ];
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * Selectively allow specific fields on edit pages of plan base objects.
 */
function ghi_plans_form_base_object_plan_edit_form_alter(&$form, FormStateInterface &$form_state) {
  PlanFormAlter::formAlter($form, $form_state);
}

/**
 * Implements hook_migrate_MIGRATE_ID_prepare_row().
 */
function ghi_plans_migrate_plan_prepare_row(Row $row, MigrateSourceInterface $source, MigrationInterface $migration) {
  $raw_data = (object) $row->getSource()['raw'];
  $plan_id = $raw_data->Id;

  /** @var \Drupal\hpc_api\Query\FabricQueryManager $query_manager */
  $query_manager = \Drupal::service('plugin.manager.fabric_query_manager');
  /** @var \Drupal\ghi_plans\Plugin\FabricQuery\PlanQuery $plan_query */
  $plan_query = $query_manager->createInstance('plan');
  $plan_query->getAllPlans();

  $plan = $plan_query->getPlan($plan_id);
  if (!$plan) {
    throw new MigrateSkipRowException();
  }

  $countries = array_map(fn(Country $country): array => $country->toArray(), $plan->getCountries());
  $plan_organizations = array_map(fn(Organization $organization): string => $organization->getAbbreviation(), $plan->getPlanOrganizations());

  $row->setSourceProperty('released', $plan->isReleased());
  $row->setSourceProperty('is_part_of_gho', $plan->isPartOfGho());
  $row->setSourceProperty('name', $plan->getName());
  $row->setSourceProperty('short_name', $plan->getShortName());
  $row->setSourceProperty('subtitle', $plan->getSubtitle());
  $row->setSourceProperty('comments', $plan->getComments());
  $row->setSourceProperty('language', $plan->getLanguageCode());
  $row->setSourceProperty('plan_cluster_type', $plan->getPlanClusterType());
  $row->setSourceProperty('plan_date_start', $plan->getStartDate());
  $row->setSourceProperty('plan_date_end', $plan->getEndDate());
  $row->setSourceProperty('plan_created_date', $plan->getCreatedDate());
  $row->setSourceProperty('plan_updated_date', $plan->getUpdatedDate());
  $row->setSourceProperty('document_published_on', $plan->getDocumentPublishedDate());
  $row->setSourceProperty('plan_type_id', $plan->getPlanType()?->id());
  $row->setSourceProperty('plan_costing_id', $plan->getPlanCostingType()?->id());
  $row->setSourceProperty('plan_year', $plan->getYear());
  $row->setSourceProperty('plan_coordinator', $plan_organizations);
  $row->setSourceProperty('countries', $countries);
  $row->setSourceProperty('focus_country_id', $plan->getFocusCountry()?->id());
  $row->setSourceProperty('latest_published_period_id', $plan->getLastPublishedReportingPeriodId());

  $financial_data = $plan_query->fetchFinancialData($plan_id);
  $row->setSourceProperty('total_funding', $financial_data['total_funding']);
  $row->setSourceProperty('overall_funding', $financial_data['overall_funding']);
  $row->setSourceProperty('current_requirements', $financial_data['current_requirements']);
  $row->setSourceProperty('original_requirements', $financial_data['original_requirements']);

  unset($plan);
}

/**
 * Implements hook_migrate_MIGRATE_ID_prepare_row().
 */
function ghi_plans_migrate_governing_entity_prepare_row(Row $row, MigrateSourceInterface $source, MigrationInterface $migration) {
  $raw_data = (object) $row->getSource()['raw'];
  $plan_id = $raw_data->PlanId;
  $plan_object = $plan_id ? BaseObjectHelper::getBaseObjectFromOriginalId($plan_id, 'plan') : NULL;
  if (!$plan_object) {
    // No associated plan node found.
    throw new MigrateSkipRowException();
  }
  // This is the internal id of the plan base object, not the source or
  // original id.
  $row->setSourceProperty('plan_entity_id', $plan_object->id());

  // Set the icon name.
  $row->setSourceProperty('icon_name', $raw_data->icon?->Name ?? NULL);

  // Use the truncated description as the name if the name is empty.
  if (empty($raw_data->Name) && !empty($raw_data->Description)) {
    $row->setSourceProperty('name', Unicode::truncate($raw_data->Description, 255, TRUE, TRUE));
  }

}
