/**
 * Repair redundant prototype additions and mislabeled legacy target columns.
 */
function ghi_plans_update_10002(): string {
  $prototype_query = \Drupal::service('plugin.manager.fabric_query_manager')->createInstance('attachment_prototype');
  $store = \Drupal::keyValue(AttachmentPrototypeQuery::FIELD_OVERRIDES_KEY_VALUE_COLLECTION);
  $overrides = $store->get(AttachmentPrototypeQuery::FIELD_OVERRIDES_KEY, []);
  $overrides = is_array($overrides) ? $overrides : [];
  $addition_prototype_ids = array_map('intval', array_keys($overrides['additions'] ?? []));
  $removed_additions = 0;

  $addition_prototypes = $prototype_query->getPrototypes($addition_prototype_ids);
  $loaded_addition_prototype_ids = array_map(fn (AttachmentPrototype $prototype): int => $prototype->id(), $addition_prototypes);
  if ($missing_prototype_ids = array_diff($addition_prototype_ids, $loaded_addition_prototype_ids)) {
    // phpcs:ignore DrupalPractice.General.ExceptionT.ExceptionT
    throw new UpdateException((string) t('Could not load attachment prototype(s) @prototype_ids while repairing field additions.', [
      '@prototype_ids' => implode(', ', $missing_prototype_ids),
    ]));
  }
  foreach ($addition_prototypes as $prototype) {
    if (!$prototype instanceof AttachmentPrototype || !is_array($overrides['additions'][$prototype->id()] ?? NULL)) {
      continue;
    }

    // Use an unmodified object to distinguish missing fields from configured
    // additions that only repeat a field already supplied by Fabric.
    $raw_prototype = new AttachmentPrototype($prototype->getRawData());
    $overrides['additions'][$prototype->id()] = array_values(array_filter($overrides['additions'][$prototype->id()], function (array $addition) use ($raw_prototype, &$removed_additions): bool {
      $metric_type = $addition['metric_type'] ?? NULL;
      $field_group = $addition['field_group'] ?? NULL;
      $fields = match ($field_group) {
        AttachmentPrototype::FIELD_GROUP_PLANNING => $raw_prototype->getPlanningFields(),
        AttachmentPrototype::FIELD_GROUP_MEASUREMENT => $raw_prototype->getMeasurementFields(),
        default => [],
      };
      if (!$metric_type || !array_key_exists($metric_type, $fields)) {
        return TRUE;
      }
      $removed_additions++;
      return FALSE;
    }));
    if (empty($overrides['additions'][$prototype->id()])) {
      unset($overrides['additions'][$prototype->id()]);
    }
  }
  $store->set(AttachmentPrototypeQuery::FIELD_OVERRIDES_KEY, $overrides);

  $metric_types = $prototype_query->getMetricTypes();
  $label_matches_metric_type = static function (string $label, string $metric_type) use ($metric_types): bool {
    foreach ($metric_types as $type) {
      if ($type->getMachineName() === $metric_type && $type->matches($label)) {
        return TRUE;
      }
    }
    return FALSE;
  };

  $node_storage = \Drupal::entityTypeManager()->getStorage('node');
  $node_ids = \Drupal::entityQuery('node')
    ->accessCheck(FALSE)
    ->exists('layout_builder__layout')
    ->execute();
  $candidate_prototype_ids = [];
  foreach (array_chunk(array_values($node_ids), 50) as $node_id_chunk) {
    foreach ($node_storage->loadMultiple($node_id_chunk) as $node) {
      foreach ($node->get('layout_builder__layout')->getValue() as $section_item) {
        /** @var \Drupal\layout_builder\Section $section */
        $section = $section_item['section'];
        foreach ($section->getComponents() as $component) {
          $configuration = $component->get('configuration');
          if ($component->getPluginId() !== 'plan_entity_logframe' || !is_array($configuration['hpc']['tables']['attachment_tables'] ?? NULL)) {
            continue;
          }
          foreach ($configuration['hpc']['tables']['attachment_tables'] as $table) {
            $prototype_id = $table['config']['attachment_prototype'] ?? NULL;
            foreach ($table['config']['table_form']['columns'] ?? [] as $column) {
              $data_point = $column['config']['data_point'] ?? [];
              $legacy_label = trim((string) ($column['config']['label'] ?? ''));
              $data_point_label = trim((string) ($data_point['label'] ?? ''));
              $label = $data_point_label ?: $legacy_label;
              if ($prototype_id && ($column['item_type'] ?? NULL) === 'data_point' && empty($data_point['data_points'][0]['metric_type']) && $label && $label_matches_metric_type($label, 'measure') && !$label_matches_metric_type($label, 'target')) {
                $candidate_prototype_ids[(int) $prototype_id] = (int) $prototype_id;
              }
            }
          }
        }
      }
    }
    $node_storage->resetCache($node_id_chunk);
  }

  $prototypes = [];
  foreach ($prototype_query->getPrototypes(array_values($candidate_prototype_ids)) as $prototype) {
    if ($prototype instanceof AttachmentPrototype) {
      $prototypes[$prototype->id()] = $prototype;
    }
  }
  if ($missing_prototype_ids = array_diff($candidate_prototype_ids, array_keys($prototypes))) {
    // phpcs:ignore DrupalPractice.General.ExceptionT.ExceptionT
    throw new UpdateException((string) t('Could not load attachment prototype(s) @prototype_ids while repairing legacy target column labels.', [
      '@prototype_ids' => implode(', ', $missing_prototype_ids),
    ]));
  }
  $updated_columns = 0;
  $updated_nodes = 0;

  foreach (array_chunk(array_values($node_ids), 50) as $node_id_chunk) {
    foreach ($node_storage->loadMultiple($node_id_chunk) as $node) {
      $sections = $node->get('layout_builder__layout')->getValue();
      $node_changed = FALSE;
      foreach ($sections as &$section_item) {
        /** @var \Drupal\layout_builder\Section $section */
        $section = $section_item['section'];
        foreach ($section->getComponents() as $component) {
          if ($component->getPluginId() !== 'plan_entity_logframe') {
            continue;
          }

          $configuration = $component->get('configuration');
          $component_changed = FALSE;
          if (!is_array($configuration['hpc']['tables']['attachment_tables'] ?? NULL)) {
            continue;
          }
          foreach ($configuration['hpc']['tables']['attachment_tables'] as &$table) {
            $prototype_id = $table['config']['attachment_prototype'] ?? NULL;
            if (!$prototype_id || !is_array($table['config']['table_form']['columns'] ?? NULL)) {
              continue;
            }
            if (!($prototypes[$prototype_id] ?? NULL) instanceof AttachmentPrototype) {
              continue;
            }
            foreach ($table['config']['table_form']['columns'] as &$column) {
              if (($column['item_type'] ?? NULL) !== 'data_point') {
                continue;
              }
              $data_point = $column['config']['data_point'] ?? [];
              if (!empty($data_point['data_points'][0]['metric_type'])) {
                continue;
              }
              $data_point_index = $data_point['data_points'][0]['index'] ?? NULL;
              $metric_type = is_numeric($data_point_index) ? $prototypes[$prototype_id]->getMetricTypeByOriginalIndex((int) $data_point_index) : NULL;
              if ($metric_type !== 'target') {
                continue;
              }

              $legacy_label = trim((string) ($column['config']['label'] ?? ''));
              $data_point_label = trim((string) ($data_point['label'] ?? ''));
              $label = $data_point_label ?: $legacy_label;
              if (!$label || !$label_matches_metric_type($label, 'measure') || $label_matches_metric_type($label, 'target')) {
                continue;
              }

              if ($data_point_label) {
                $column['config']['data_point']['label'] = '';
              }
              if ($legacy_label) {
                $column['config']['label'] = '';
              }
              $component_changed = TRUE;
              $node_changed = TRUE;
              $updated_columns++;
            }
            unset($column);
          }
          unset($table);

          if ($component_changed) {
            $component->setConfiguration($configuration);
          }
        }
      }
      unset($section_item);

      if ($node_changed) {
        $node->get('layout_builder__layout')->setValue($sections);
        $node->setSyncing(TRUE);
        $node->save();
        $updated_nodes++;
      }
    }
    $node_storage->resetCache($node_id_chunk);
  }

  return (string) t('Removed @addition_count redundant attachment prototype field addition(s) and repaired @column_count legacy target column label(s) on @node_count page(s).', [
    '@addition_count' => $removed_additions,
    '@column_count' => $updated_columns,
    '@node_count' => $updated_nodes,
  ]);
}
