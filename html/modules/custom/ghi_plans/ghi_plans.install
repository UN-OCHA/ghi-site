/**
 * Use the prototype label for the plan 934 target column.
 */
function ghi_plans_update_10002(): string {
  $store = \Drupal::keyValue(AttachmentPrototypeQuery::FIELD_OVERRIDES_KEY_VALUE_COLLECTION);
  $overrides = $store->get(AttachmentPrototypeQuery::FIELD_OVERRIDES_KEY, []);
  if (is_array($overrides['additions'][4171] ?? NULL)) {
    $overrides['additions'][4171] = array_values(array_filter($overrides['additions'][4171], function (array $addition): bool {
      return ($addition['metric_type'] ?? NULL) !== 'in_need' || ($addition['field_group'] ?? NULL) !== AttachmentPrototype::FIELD_GROUP_PLANNING;
    }));
    if (empty($overrides['additions'][4171])) {
      unset($overrides['additions'][4171]);
    }
    $store->set(AttachmentPrototypeQuery::FIELD_OVERRIDES_KEY, $overrides);
  }

  $plans = \Drupal::entityTypeManager()->getStorage('base_object')->loadByProperties([
    'type' => 'plan',
    'field_original_id' => 934,
  ]);
  $plan = reset($plans);
  if (!$plan) {
    return (string) t('Plan 934 was not found; no logframe column label was updated.');
  }

  $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadByProperties([
    'type' => 'section',
    'field_base_object' => $plan->id(),
  ]);
  $updated = 0;
  foreach ($nodes as $node) {
    if (!$node->hasField('layout_builder__layout')) {
      continue;
    }

    $sections = $node->get('layout_builder__layout')->getValue();
    $changed = FALSE;
    foreach ($sections as &$section_item) {
      /** @var \Drupal\layout_builder\Section $section */
      $section = $section_item['section'];
      foreach ($section->getComponents() as $component) {
        if ($component->getPluginId() !== 'plan_entity_logframe') {
          continue;
        }

        $configuration = $component->get('configuration');
        $component_changed = FALSE;
        if (!is_array($configuration['hpc']['tables']['attachment_tables'] ?? NULL)) {
          continue;
        }
        foreach ($configuration['hpc']['tables']['attachment_tables'] as &$table) {
          if (($table['config']['attachment_prototype'] ?? NULL) != 4171) {
            continue;
          }
          if (!is_array($table['config']['table_form']['columns'] ?? NULL)) {
            continue;
          }
          foreach ($table['config']['table_form']['columns'] as &$column) {
            $data_point_index = $column['config']['data_point']['data_points'][0]['index'] ?? NULL;
            if (($column['item_type'] ?? NULL) === 'data_point' && $data_point_index == 1 && ($column['config']['label'] ?? NULL) === 'Measure') {
              $column['config']['label'] = '';
              $changed = TRUE;
              $component_changed = TRUE;
            }
          }
          unset($column);
        }
        unset($table);

        if ($component_changed) {
          $component->setConfiguration($configuration);
        }
      }
    }
    unset($section_item);

    if ($changed) {
      $node->get('layout_builder__layout')->setValue($sections);
      $node->setSyncing(TRUE);
      $node->save();
      $updated++;
    }
  }

  return (string) t('Updated the plan 934 target column label on @count section.', ['@count' => $updated]);
}
